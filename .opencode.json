{
  "$schema": "https://opencode.ai/schema.json",
  "name": "TerrariaBench",
  "description": "AfterQuery RL Environment Challenge + Frontier Models (Gemini, Codex, Gemma)",
  "mcpServers": {
    "terraria-mcp": {
      "command": "python",
      "args": ["mcp_server/terraria_mcp.py"]
    }
  },
  "defaultModel": "google/gemini-2.5-pro",
  "supportedModels": [
    "google/gemini-2.5-pro",
    "openai/codex",
    "google/gemma-2-9b-it"
  ]
}
