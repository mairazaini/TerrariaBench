# TerrariaBench Cloud Environment Keys
# Replace placeholder values with your real credentials:

# 1. Aiven PostgreSQL Service URI (e.g., postgres://avnadmin:pass@pg-project.aivencloud.com:12345/defaultdb?sslmode=require)
AIVEN_PG_URL=postgres://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST:PORT/defaultdb?sslmode=require

# 2. Google Gemini API Key (e.g., AIzaSy...)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 3. OpenAI API Key (e.g., sk-...)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# 4. Optional / Partner Keys:
CONTEXT_DEV_API_KEY=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
MODAL_VLLM_URL=
VERDA_VLLM_URL=
